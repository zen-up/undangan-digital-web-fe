{
    // Editor
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.codeActionsOnSave": {
        "source.fixAll": "always",
        "source.fixAll.eslint": "explicit",
        "source.organizeImports": "never"
    },
    // Prettier
    "prettier.enable": false,
    "prettier.semi": true,
    "prettier.tabWidth": 4,
    "prettier.singleQuote": true,
    // Eslint
    "eslint.format.enable": true,
    "eslint.useFlatConfig": true,
    "eslint.rules.customizations": [
        {
            "rule": "style/*",
            "severity": "off"
        },
        {
            "rule": "format/*",
            "severity": "off"
        },
        {
            "rule": "*-indent",
            "severity": "off"
        },
        {
            "rule": "*-spacing",
            "severity": "off"
        },
        {
            "rule": "*-spaces",
            "severity": "off"
        },
        {
            "rule": "*-order",
            "severity": "off"
        },
        {
            "rule": "*-dangle",
            "severity": "off"
        },
        {
            "rule": "*-newline",
            "severity": "off"
        },
        {
            "rule": "*quotes",
            "severity": "off"
        },
        {
            "rule": "*semi",
            "severity": "off"
        }
    ],
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "vue",
        "html",
        "markdown",
        "json",
        "jsonc",
        "yaml"
    ],
    "css.lint.unknownAtRules": "ignore",
    "scss.lint.unknownAtRules": "ignore",
    "[vue]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[typescript]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[javascript]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[yaml]": {
        "editor.tabSize": 4
    },
    "[json]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "i18n-ally.localesPaths": [
        "locales"
    ],
    "cSpell.words": [
        "Borderless",
        "cardable",
        "cerpenku",
        "cmdk",
        "commitlint",
        "czrc",
        "danwsaps",
        "datepicker",
        "embla",
        "extralight",
        "formkit",
        "healthcheck",
        "hebilicious",
        "Lato",
        "lucide",
        "Maska",
        "nprogress",
        "nuxi",
        "nuxtjs",
        "persistedstate",
        "reka",
        "Selamat",
        "shadcn",
        "sonner",
        "uuidv",
        "vaul",
        "versionrc",
        "vuepic",
        "vueuse"
    ]
}
